# =====================================================================
# job-agent : secrets (EXEMPLE)
#
# Mode d'emploi :
#   1. Copiez ce fichier et nommez la copie ".env".
#   2. Complétez les valeurs après le signe "=", sans espace ni guillemets.
#   3. .env est personnel : il n'est jamais envoyé sur GitHub.
#   4. En mode cloud (GitHub Actions), ces valeurs se saisissent dans
#      Settings > Secrets and variables > Actions, avec les mêmes noms.
#
# Ne remplissez que les services que vous avez activés dans config.yaml.
# Les commentaires sont toujours sur leur propre ligne.
# =====================================================================


# ---------------------------------------------------------------------
# FRANCE TRAVAIL (source : API Offres d'emploi)
# Où l'obtenir : francetravail.io > créer une application > l'abonner
# à l'API "Offres d'emploi". Les deux valeurs sont affichées sur la
# fiche de l'application.
# ---------------------------------------------------------------------
# Identifiant client de l'application
FRANCE_TRAVAIL_CLIENT_ID=
# Clé secrète de l'application
FRANCE_TRAVAIL_CLIENT_SECRET=


# ---------------------------------------------------------------------
# ADZUNA (source : API de l'agrégateur)
# Où l'obtenir : developer.adzuna.com > créer un compte > Dashboard.
# ---------------------------------------------------------------------
# Identifiant de l'application
ADZUNA_APP_ID=
# Clé de l'application
ADZUNA_APP_KEY=


# ---------------------------------------------------------------------
# GMAIL (source : alertes e-mail, accès en lecture seule)
# Où l'obtenir : Google Cloud Console > créer un projet > activer
# l'API Gmail > créer un identifiant OAuth de type "Application de
# bureau". Le jeton d'actualisation est généré une seule fois par une
# commande de l'agent (expliquée dans le README).
# ---------------------------------------------------------------------
# Identifiant client OAuth
GMAIL_CLIENT_ID=
# Code secret du client OAuth
GMAIL_CLIENT_SECRET=
# Jeton d'actualisation (généré par l'agent)
GMAIL_REFRESH_TOKEN=


# ---------------------------------------------------------------------
# GOOGLE SHEETS (fichier de suivi, si tracking.backend = google_sheets)
# Où l'obtenir : Google Cloud Console > activer l'API Google Sheets >
# créer un "compte de service" > télécharger sa clé au format JSON.
# Partagez ensuite votre feuille avec l'adresse e-mail du compte de
# service. Remplissez UNE SEULE des deux lignes :
#   - sur votre ordinateur : le chemin du fichier JSON, dans private/ ;
#   - dans GitHub Actions : le contenu complet du fichier JSON.
# ---------------------------------------------------------------------
# Chemin du fichier JSON (exemple : private/google_service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Contenu du fichier JSON (mode cloud uniquement)
GOOGLE_SERVICE_ACCOUNT_JSON=


# ---------------------------------------------------------------------
# TELEGRAM (notifications, si notifications.channel = telegram)
# Où l'obtenir : dans Telegram, écrivez à @BotFather, commande /newbot.
# Il vous donne le jeton du bot. L'identifiant de conversation se
# récupère ensuite avec une commande de l'agent (expliquée dans le README).
# ---------------------------------------------------------------------
# Jeton du bot
TELEGRAM_BOT_TOKEN=
# Identifiant de la conversation qui reçoit les notifications
TELEGRAM_CHAT_ID=


# ---------------------------------------------------------------------
# E-MAIL (notifications, si notifications.channel = email)
# Pour Gmail : serveur smtp.gmail.com, port 587, et un "mot de passe
# d'application" (Compte Google > Sécurité > Mots de passe des
# applications), jamais votre mot de passe habituel.
# ---------------------------------------------------------------------
# Serveur d'envoi
SMTP_HOST=
# Port du serveur
SMTP_PORT=
# Adresse e-mail qui envoie
SMTP_USERNAME=
# Mot de passe d'application
SMTP_PASSWORD=
# Adresse qui reçoit les notifications
NOTIFICATION_EMAIL_TO=


# ---------------------------------------------------------------------
# GEMINI (intelligence artificielle, si ai.provider = gemini)
# Où l'obtenir : Google AI Studio > Get API key. Niveau gratuit, sans
# carte bancaire.
# ---------------------------------------------------------------------
# Clé d'API Gemini
GEMINI_API_KEY=
